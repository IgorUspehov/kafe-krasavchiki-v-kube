# Google reCAPTCHA v3
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=your_site_key
RECAPTCHA_SECRET_KEY=your_secret_key

# LemonSqueezy
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_STORE_ID=
LEMONSQUEEZY_VARIANT_ID=
LEMONSQUEEZY_WEBHOOK_SECRET=

# Polar (checkout webhooks + CRM Demo monthly subscription)
POLAR_WEBHOOK_SECRET=
POLAR_ACCESS_TOKEN=
# After creating €99/month product (scripts/setup-polar-crm-demo-monthly.mjs):
# POLAR_PRODUCT_CRM_DEMO=
# NEXT_PUBLIC_POLAR_PRODUCT_CRM_DEMO=
# POLAR_CHECKOUT_CRM_DEMO=
# NEXT_PUBLIC_POLAR_CHECKOUT_CRM_DEMO=

# Cloudflare Pages shared project (preview deployments per CRM Demo)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_PAGES_PROJECT_NAME=crm-demo-sites
CLOUDFLARE_DEPLOYMENT_KEEP=40
# Test-mode: auto-delete unpaid CRM Demo deployments after N minutes
CRM_DEMO_TTL_MINUTES=10
MVP_DIST_PATH=

# Optional: used for post-payment redirect URL in checkout
NEXT_PUBLIC_SITE_URL=https://webstudio-muenchen.com

# Factory Website+CRM origin for €499 / €999 bridge (query params only, no templates)
NEXT_PUBLIC_FACTORY_WEBSITE_URL=

# Optional: MVP Pro download email (Resend)
RESEND_API_KEY=
RESEND_FROM_EMAIL=CRM Demo <noreply@yourdomain.com>

# Manual CRM Demo email test: POST /api/crm-demo/fulfill
CRM_DEMO_FULFILL_SECRET=

# Storage cleanup API auth
STORAGE_CLEANUP_SECRET=

# Firebase Admin (CRM Full tier provisioning)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
