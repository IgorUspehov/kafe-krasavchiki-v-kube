# Polar webhook (Settings → Webhooks → secret starts with whsec_)
POLAR_WEBHOOK_SECRET=

# Polar API (Organization Settings → Access Tokens; optional — checkout-lookup uses webhook cache)
POLAR_ACCESS_TOKEN=

# Public site URL for post-payment redirects (no trailing slash)
NEXT_PUBLIC_SITE_URL=https://webstudio-muenchen.com

IS_DEPLOYABLE_ZIP=true
